@page "/not-found"
@layout MainLayout

<PageTitle>Página não encontrada - GuardiA</PageTitle>

<div class="container mt-5 text-center">
    <div class="p-5 rounded bg-dark text-light border border-secondary shadow-sm">
        <h1 class="display-5 text-warning mb-3">⚠️ 404</h1>
        <h3>Página não encontrada</h3>
        <p class="text-secondary mt-2 mb-4">
            Desculpe, o conteúdo ou endereço que você está procurando não existe ou foi removido.
        </p>
        <a href="/" class="btn btn-primary fw-bold px-4">
            🏠 Voltar para a Página Inicial
        </a>
    </div>
</div>