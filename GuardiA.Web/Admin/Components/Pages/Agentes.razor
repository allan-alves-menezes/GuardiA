@page "/agentes"
@page "/agents"
@rendermode InteractiveServer
@using System.Net.Http.Json

<PageTitle>Agentes Monitorados — GuardiA</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 text-white">Agentes Monitorados</h3>
            <small class="text-secondary">Telemetria em tempo real dos endpoints conectados à GuardiA</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="CarregarAgentesAsync" disabled="@isLoading">
            @(isLoading ? "Atualizando..." : "Atualizar")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(erroMensagem))
    {
        <div class="alert alert-danger" role="alert">
            @erroMensagem
        </div>
    }
    else if (isLoading && agentes.Count == 0)
    {
        <div class="text-secondary">Carregando agentes...</div>
    }
    else if (agentes.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Nenhum agente registrado até o momento.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Máquina</th>
                        <th>Cliente</th>
                        <th>Sistema Operacional</th>
                        <th>Versão</th>
                        <th>CPU</th>
                        <th>Memória</th>
                        <th>Conexões TCP</th>
                        <th>Firewall / Defender</th>
                        <th>Último Contato (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agente in agentes)
                    {
                        <tr>
                            <td class="fw-semibold">@agente.MachineName</td>
                            <td>@agente.ClientId</td>
                            <td>@agente.OsDescription</td>
                            <td><span class="badge bg-secondary">@agente.AgentVersion</span></td>
                            <td>@agente.CpuLoadPercent.ToString("0.0")%</td>
                            <td>@agente.MemoryUsedPercent.ToString("0.0")%</td>
                            <td>@agente.ActiveTcpConnectionsCount</td>
                            <td>
                                @{
                                    var fwOk = (agente.WindowsFirewallDomainEnabled ?? true) &&
                                                 (agente.WindowsFirewallPrivateEnabled ?? true) &&
                                                 (agente.WindowsFirewallPublicEnabled ?? true);
                                }
                                <span class="badge @(fwOk ? "bg-success" : "bg-warning text-dark")">
                                    @(fwOk ? "FW OK" : "FW Alerta")
                                </span>
                                @if (!string.IsNullOrWhiteSpace(agente.DefenderRealTimeStatus))
                                {
                                    <span class="badge bg-info text-dark ms-1">@agente.DefenderRealTimeStatus</span>
                                }
                            </td>
                            <td>@agente.LastSeenUtc.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;

    private List<AgentDeviceView> agentes = new();
    private bool isLoading = true;
    private string? erroMensagem;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAgentesAsync();
    }

    private async Task CarregarAgentesAsync()
    {
        isLoading = true;
        erroMensagem = null;

        try
        {
            var client = HttpClientFactory.CreateClient("GuardiaApi");
            if (client.BaseAddress is null)
            {
                client = HttpClientFactory.CreateClient();
                client.BaseAddress = new Uri("http://localhost:8080/");
            }

            var lista = await client.GetFromJsonAsync<List<AgentDeviceView>>("api/v1/agent/devices");
            agentes = lista ?? new();
        }
        catch (Exception ex)
        {
            erroMensagem = $"Não foi possível carregar os agentes: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class AgentDeviceView
    {
        public string DeviceKey { get; set; } = string.Empty;
        public string ClientId { get; set; } = string.Empty;
        public string MachineName { get; set; } = string.Empty;
        public string OsDescription { get; set; } = string.Empty;
        public string AgentVersion { get; set; } = string.Empty;
        public DateTimeOffset LastSeenUtc { get; set; }
        public double CpuLoadPercent { get; set; }
        public double MemoryUsedPercent { get; set; }
        public int ActiveTcpConnectionsCount { get; set; }
        public bool? WindowsFirewallDomainEnabled { get; set; }
        public bool? WindowsFirewallPrivateEnabled { get; set; }
        public bool? WindowsFirewallPublicEnabled { get; set; }
        public string? DefenderRealTimeStatus { get; set; }
    }
}