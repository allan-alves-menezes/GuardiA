@inherits LayoutComponentBase
@implements IDisposable
@using GuardiA.Admin.Services
@inject GuardiaTelemetryService Telemetry
@inject NavigationManager Nav

<div class="guardia-wrapper d-flex min-vh-100">
    <!-- Barra Lateral (Sidebar) - Fixa à esquerda -->
    <aside class="guardia-sidebar d-flex flex-column p-3" aria-label="Navegação principal">
        <div class="d-flex align-items-center mb-4 px-2">
            <i class="bi bi-shield-shaded fs-3 text-info me-2" aria-hidden="true"></i>
            <span class="fs-4 fw-bold text-white" translate="no">Guardi<span class="text-info">A</span></span>
        </div>

        <ul class="nav nav-pills flex-column mb-auto gap-1">
            <li class="nav-item">
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-link guardia-nav-link">
                    <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i> Painel
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/targets" class="nav-link guardia-nav-link">
                    <i class="bi bi-crosshair me-2" aria-hidden="true"></i> Alvos &amp; Varredura
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/alertas" class="nav-link guardia-nav-link">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i> Alertas
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/vulnerabilidades" class="nav-link guardia-nav-link">
                    <i class="bi bi-bug me-2" aria-hidden="true"></i> Vulnerabilidades
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/agentes" class="nav-link guardia-nav-link">
                    <i class="bi bi-pc-horizontal me-2" aria-hidden="true"></i> Agentes
                </NavLink>
            </li>
        </ul>

        <!-- Rodapé da Sidebar (Status da API) -->
        <div class="mt-auto p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25" style="font-size: 0.85rem;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center text-secondary">
                    <span class="status-dot @StatusDotClass me-2" aria-hidden="true"></span>
                    <span>API: @Telemetry.ApiStatusLabel</span>
                </div>
                <button type="button"
                        class="btn btn-sm btn-link text-info p-0"
                        @onclick="RefreshHealthAsync"
                        title="Atualizar status da API">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                </button>
            </div>
            @if (Telemetry.LastScanAt.HasValue)
            {
                <div class="text-muted small">
                    Última varredura: <br>
                    <strong>@Telemetry.LastScanAt.Value.ToLocalTime().ToString("G")</strong>
                </div>
            }
        </div>
    </aside>

    <!-- Área Principal -->
    <div class="flex-grow-1 d-flex flex-column guardia-main">
        <!-- Barra Superior (TopBar) - Fixa no topo -->
        <header class="guardia-topbar px-4 py-3 d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-10">
            <h1 class="h5 mb-0 fw-semibold text-white">GuardiA Admin - Painel de Segurança</h1>
            <div class="d-flex align-items-center gap-4">
                <!-- Área do Score de Segurança -->
                <div class="score-box px-3 py-1 rounded-3 d-flex align-items-center gap-2" aria-label="Pontuação de segurança">
                    <span class="text-secondary small">Score:</span>
                    <span class="fw-bold text-info fs-4">@Telemetry.SecurityScore</span>
                    <span class="text-secondary small">/100</span>
                    @if (Telemetry.SecurityScore >= 80)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 ms-2 px-2 py-1 small fw-normal">
                            <i class="bi bi-check-circle-fill me-1"></i> PROTEGIDO
                        </span>
                    }
                </div>
                <!-- Ícones de Notificação e Perfil -->
                <div class="d-flex align-items-center gap-3 text-secondary fs-5">
                    <button type="button" class="btn btn-link text-secondary p-0" aria-label="Notificações">
                        <i class="bi bi-bell"></i>
                    </button>
                    <button type="button" class="btn btn-link text-secondary p-0" aria-label="Perfil">
                        <i class="bi bi-person-circle"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Conteúdo Dinâmico da Página -->
        <main class="p-4 flex-grow-1 overflow-auto" id="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private string StatusDotClass => Telemetry.IsApiOnline ? "status-online" : "status-offline";

    protected override async Task OnInitializedAsync()
    {
        await Telemetry.CheckApiHealthAsync();
    }

    private async Task RefreshHealthAsync()
    {
        await Telemetry.CheckApiHealthAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        GC.SuppressFinalize(this);
    }
}