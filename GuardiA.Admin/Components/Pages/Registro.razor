@page "/registro"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using GuardiA.Admin.Models
@inject NavigationManager Navigation

<div class="container mt-5" style="max-width: 520px;">
    <div class="card bg-dark text-light border-secondary shadow">
        <div class="card-body p-4">
            <h3 class="mb-2">🛡️ Crie sua conta GuardiA</h3>

            @if (Origem == "download")
            {
                <p class="text-info small">Registre-se gratuitamente para liberar o instalador do agente desktop e gerar sua chave de API.</p>
            }
            else
            {
                <p class="text-info small">Cadastre seu e-mail e gere sua chave de acesso para utilizar a Web API e o monitoramento GuardiA.</p>
            }

            @if (!string.IsNullOrWhiteSpace(MensagemErro))
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    @MensagemErro
                </div>
            }

            <EditForm Model="NovoUsuario" OnValidSubmit="RegistrarUsuario" FormName="FormRegistro">
                <div class="mb-3">
                    <label class="form-label">Nome completo</label>
                    <InputText @bind-Value="NovoUsuario.Nome" class="form-control bg-secondary text-white border-0" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">E-mail para alertas e acesso</label>
                    <InputText @bind-Value="NovoUsuario.Email" type="email" class="form-control bg-secondary text-white border-0" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Senha (mínimo 6 caracteres)</label>
                    <InputText @bind-Value="SenhaPlana" type="password" class="form-control bg-secondary text-white border-0" minlength="6" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold" disabled="@Enviando">
                    @if (Enviando)
                    {
                        <span>Cadastrando...</span>
                    }
                    else
                    {
                        <span>@(Origem == "download" ? "Registrar e Liberar Download" : "Registrar e Gerar Chave")</span>
                    }
                </button>
            </EditForm>

            @if (CadastroConcluido)
            {
                <div class="alert alert-success mt-3 mb-0">
                    <strong>Conta criada!</strong> Sua chave de API (<code>X-Api-Key</code>) é:
                    <div class="mt-1 p-2 bg-dark text-success rounded font-monospace small text-break">
                        @ChaveGerada
                    </div>
                    @if (Origem == "download")
                    {
                        <div class="mt-2">
                            <a href="/downloads/GuardiA-Setup.exe" class="btn btn-sm btn-success">⬇️ Baixar Programa Agora</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Origem { get; set; }

    private UsuarioMonitorado NovoUsuario { get; set; } = new();
    private string SenhaPlana { get; set; } = string.Empty;
    private string ChaveGerada { get; set; } = string.Empty;
    private string? MensagemErro { get; set; }
    private bool CadastroConcluido { get; set; } = false;
    private bool Enviando { get; set; } = false;

    private HttpClient CriarClienteApi()
    {
        var client = HttpClientFactory.CreateClient("GuardiaApi");
        if (client.BaseAddress is null)
        {
            client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri("http://localhost:8080/");
        }
        return client;
    }

    private async Task RegistrarUsuario()
    {
        MensagemErro = null;
        CadastroConcluido = false;
        Enviando = true;

        try
        {
            var client = CriarClienteApi();
            var response = await client.PostAsJsonAsync("api/v1/auth/register", new
            {
                Name = NovoUsuario.Nome,
                Email = NovoUsuario.Email,
                Password = SenhaPlana
            });

            if (!response.IsSuccessStatusCode)
            {
                var erroPayload = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                MensagemErro = erroPayload?.Erro ?? $"Não foi possível concluir o cadastro (HTTP {(int)response.StatusCode}).";
                return;
            }

            var criado = await response.Content.ReadFromJsonAsync<RegisterApiResponse>();
            ChaveGerada = criado?.ApiKey ?? string.Empty;
            NovoUsuario.ChaveLicencaAgente = ChaveGerada;
            NovoUsuario.NotificacoesAtivas = true;

            if (Origem == "download")
                NovoUsuario.BaixouAgenteDesktop = true;

            CadastroConcluido = true;
            SenhaPlana = string.Empty;
        }
        catch (Exception ex)
        {
            MensagemErro = $"Erro ao conectar com a API: {ex.Message}";
        }
        finally
        {
            Enviando = false;
        }
    }

    private sealed class RegisterApiResponse
    {
        public long UserId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string ApiKey { get; set; } = string.Empty;
    }

    private sealed class ApiErrorResponse
    {
        public string? Erro { get; set; }
    }
}